{
  "info": {
    "_postman_id": "lab7-api-gateway-service-discovery-cloud",
    "name": "Microservices – Lab 7 (API Gateway & Cloud)",
    "description": "Postman Collection for Web Services & SOA Lab 7: API Gateway, Configuration-Based Service Discovery & Cloud Deployment. All requests are routed exclusively through the API Gateway single public entry point.",
